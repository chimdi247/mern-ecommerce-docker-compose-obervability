# ============================================================
# MERN Ecommerce - Environment Variables
# ============================================================
# `docker compose up --build` works immediately with this file as-is
# EXCEPT for signing in -- this app's authentication is entirely
# delegated to Clerk (a hosted identity provider), so you must supply
# real Clerk API keys below before sign-in/sign-up will work at all.
# See docker/README.md for the full explanation and the exact steps
# (it's not something a docker-compose file or a DB seed script can
# route around). Cloudinary/Razorpay are optional -- uploads/payments
# just won't work until you fill those in, nothing else depends on them.
# ============================================================

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# MongoDB -- must stay consistent with the mongo service in
# docker-compose.yml
# ------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017/ecommerce

# ------------------------------------------------------------
# Clerk (REQUIRED for sign-in/sign-up to work at all -- see
# docker/README.md). Get free keys at https://clerk.com
# ------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Emails in this list are auto-promoted to role="admin" the first time
# they sign in (see server/src/routes/auth/auth.routes.ts). Pre-set to
# the login you asked for -- sign up with this email through the app
# once you've added real Clerk keys above.
ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------
# Cloudinary (product image uploads) -- optional, blank by default
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------
# Razorpay (checkout payments) -- optional, blank by default
# ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------
# Frontend (Vite) -- VITE_* values are inlined into the bundle at
# build time (see client/Dockerfile's build args)
# ------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------
# OpenTelemetry (auto-instrumentation bootstrap -- see
# server/src/otel/otel-bootstrap.ts and observability/README.md)
# ------------------------------------------------------------
OTEL_SERVICE_NAME=ecommerce-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_PROMETHEUS_PORT=9464

# ------------------------------------------------------------
# Ports published to the host
# ------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGO_PORT=27017
GRAFANA_PORT=3001
PROMETHEUS_PORT=9091
LOKI_PORT=3100
TEMPO_PORT=3200


MAIL_USERNAME=john@gmail.com
MAIL_PASSWORD=
MAIL_FROM=example@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com



# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
# Where CPU/memory/business-logic alert emails are sent (see
# observability/grafana/provisioning/alerting/contact-points.yaml).
# This app has no SMTP config of its own to borrow (unlike the other
# example projects) -- add GF_SMTP_* settings directly in
# docker-compose.yml's grafana service if you want delivery to
# actually work; until then alerts still fire and show in the
# Grafana UI, they just won't email out.
ALERT_EMAIL_TO=admin@example.com
